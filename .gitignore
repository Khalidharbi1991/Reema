# Local customer material (including email and spreadsheets)
references/**
!references/README.md
diagrams/

# Customer-specific material lives outside REEMA (D:\Customer Material) and never comes back.
# These patterns stop a stray copy from being committed.
*[Ss]audia*
*CUSTOMER*

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Team folders: every team's input, output, data and nested project repos stay local.
# Only teams/README.md and the explanatory references README are tracked.
/teams/*/
!/teams/documentation/
/teams/documentation/*
!/teams/documentation/input/
/teams/documentation/input/*
!/teams/documentation/input/references/
/teams/documentation/input/references/*
!/teams/documentation/input/references/README.md

# Logs
logs/
*.log

# Output files
output/
*.pdf
*.docx
*.html

# Customer data, email, CAD/diagram sources and local stores, in any folder
*.xlsx
*.csv
*.msg
*.dwg
*.dxf
*.drawio
*.sqlite3
.recovery-key

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.tmp
*.bak
*.cache

# Snafi worker: prompt text built at deploy time (lives only in the worker copy)
/src/snafi_worker/ahmad_base.txt
