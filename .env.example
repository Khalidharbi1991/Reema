# Anthropic API Key (Required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Set true only for inputs authorized for transmission to Anthropic.
# Prefer the per-run --allow-external-ai flag when permissions vary by document.
ALLOW_EXTERNAL_AI=false

# Optional Configuration
# PROJECT_ROOT=.
# OUTPUT_DIR=./output
# TASK_DATA_DIR=./output/assistant
# USER_TIMEZONE=Asia/Riyadh
# REFERENCES_DIR=./references
# LEADER_MODEL=claude-sonnet-4-6
# WORKER_MODEL=claude-sonnet-4-6

# API_TIMEOUT_SECONDS=120
# API_MAX_RETRIES=2
# MAX_CONCURRENT_AGENTS=5
# MAX_RUN_TOKENS=1000000
# MAX_PROMPT_CHARS=200000
# REVIEW_CHUNK_CHARS=24000
# KNOWLEDGE_CONTEXT_CHARS=12000
# REFERENCE_MANIFEST=references/manifest.yaml
# ENFORCE_PAGE_TARGET=false
# PAGE_TARGET=[15,30]
# Optional user-maintained [input, output] USD per million token rates by model.
# Unconfigured cost is unknown, not zero. No prices are assumed.
# MODEL_PRICES={"your-model-id":[0.0,0.0]}
