# Copy to .env.local (gitignored) and fill in from Supabase:
# Project Settings -> API Keys. Never commit .env.local.
#
# Only the publishable (anon) key belongs in the web app. The secret /
# service_role key is for the PC worker (step 2) and never goes here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The site's own address, used for every redirect (never the request's Host).
# Not needed for `npm run dev`. On Vercel it defaults to Vercel's own address;
# set it once you add your own domain. For `npm start` on this PC use
# http://127.0.0.1:3000.
SNAFI_SITE_URL=

# Sign-in throttle (SEC-4): 32+ random characters, server-only (no NEXT_PUBLIC_).
# Required outside `npm run dev`. Make one with PowerShell:
#   -join ((1..48) | % { '{0:x}' -f (Get-Random -Max 16) })
SNAFI_THROTTLE_SECRET=
