{
  "name": "snafi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Snafi, Khalid's personal assistant web app (REEMA). Step 1: skeleton.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
